{
  "name": "smarthive-connect",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "tsx server.ts",
    "dev:server": "tsx watch server.ts",
    "build:server": "esbuild server.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist-server/server.cjs",
    "start": "concurrently \"npm run dev:server\" \"npm run dev\" --kill-others --prefix-colors \"blue,green\"",
    "deploy": "npm run build && gh-pages -d dist",
    "deploy:baota": "bash deploy.sh",
    "package": "powershell ./package.ps1",
    "lint": "echo 'Linting check - add eslint if needed'",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "vitest",
    "test:iot-pressure": "tsx scripts/iot-pressure-test.ts",
    "check:iot-link": "tsx scripts/check-iot-link.ts",
    "seed:sim": "tsx scripts/seed-sim-data.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "antd": "^6.3.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "d3": "^7.9.0",
    "d3-array": "^3.2.4",
    "dotenv": "^17.2.3",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "express": "^5.2.1",
    "framer-motion": "^12.36.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.556.0",
    "mqtt": "^5.14.1",
    "mysql2": "^3.20.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-is": "^19.2.4",
    "react-router-dom": "^6.26.2",
    "recharts": "^3.5.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.2",
    "@storybook/addon-essentials": "^8.6.0",
    "@storybook/addon-interactions": "^8.6.0",
    "@storybook/addon-links": "^8.6.0",
    "@storybook/react-vite": "^8.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/compression": "^1.8.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.24.0",
    "gh-pages": "^6.3.0",
    "jsdom": "^28.1.0",
    "storybook": "^8.6.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "~5.8.2",
    "vite": "^5.4.10",
    "vitest": "^4.0.18"
  }
}
