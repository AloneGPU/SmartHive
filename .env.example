# 服务器配置
PORT=3001

# 数据库配置（可选）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的数据库密码
DB_NAME=smarthive

# API Token（前端经管理员登录后由后端下发，或普通用户在登录页填写并校验）
API_TOKEN=你的API令牌（至少16位）

# 管理员登录密码（与前端「管理员」入口对应，请使用强密码）
ADMIN_PASSWORD=你的管理员登录密码

# AI服务配置（可选）
QWEN_API_KEY=你的Qwen API密钥

# 高德地图API配置（可选）
GAODE_API_KEY=你的高德地图API密钥

# CORS配置（生产环境）
CORS_ORIGIN=https://你的域名

# 视频与视觉配置（可选）
VIDEO_STREAM_URL=/api/vision/stream.mjpg
VIDEO_STREAM_MODE=mjpeg
VISION_DEVICE_ID=pi5-vision-client

# 视频代理白名单（可选）：仅当上游为公网域名或非内网 IP 时需要，逗号分隔主机名，如 cam.example.com,192.0.2.1
# 不设置时默认仅允许 localhost、私网 IPv4、169.254.*、*.local
# VISION_PROXY_ALLOWED_HOSTS=

# 管理后台「视频探测」时，后端请求视频源的超时（毫秒），默认 8000
# VISION_PROBE_TIMEOUT_MS=8000

# MQTT 采集（树莓派 -> 后端）
MQTT_BROKER_URL=mqtt://127.0.0.1:1883
MQTT_SENSOR_TOPIC=smarthive/+/sensors
MQTT_SUB_QOS=1

# MQTT 落库间隔（分钟）
# 0 = 每条消息都落库；60 = 每个设备每类传感器每小时落一条
MQTT_STORAGE_BUCKET_MINUTES=60

# 是否将 IoT 数据镜像写入 hive_data（让总览/细分主图可直接使用树莓派数据）
IOT_MIRROR_TO_BEEHIVE=true
