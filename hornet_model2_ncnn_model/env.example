# 复制本文件为 .env（与 config.yaml 同目录），由 launch.sh 自动加载。
# 勿将 .env 打进镜像或提交到 Git；config.yaml 中不再存放密码与 API 令牌。

# —— MQTT（本地 Broker，与 EMQX/后端 MQTT 账号一致）——
SMART_HIVE_MQTT_HOST=127.0.0.1
SMART_HIVE_MQTT_PORT=1883
SMART_HIVE_MQTT_USERNAME=123456
SMART_HIVE_MQTT_PASSWORD=226886
SMART_HIVE_MQTT_CLIENT_ID=pi5-vision-client

# —— 后端 API（与服务器 API_TOKEN 一致，同时用于推流帧与 /api/beehive 归档）——
SMART_HIVE_API_TOKEN=G1AUlrlDXiQMl6Kc
SMART_HIVE_BEEHIVE_URL=http://121.196.155.132/api/beehive
SMART_HIVE_VISION_UPLOAD_URL=http://121.196.155.132/api/vision/frame

# —— 云端 MQTT（用于断网缓存补传，需与后端 MQTT_BROKER_URL 一致）——
SMART_HIVE_CLOUD_ENABLED=true
SMART_HIVE_CLOUD_BROKER_URL=mqtt://121.196.155.132:1883
SMART_HIVE_CLOUD_USERNAME=123456
SMART_HIVE_CLOUD_PASSWORD=226886

# 设为 1 启用传感器/MQTT/视觉等诊断日志（等同 config diagnostics.enabled）
# SMART_HIVE_DIAGNOSTICS=1
